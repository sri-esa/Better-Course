# YouTube Data API v3 key (Required in production)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database connection URL (SQLite for dev/tests, PostgreSQL for prod)
DATABASE_URL=sqlite:///./studyflow.db

# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173

# LLM configuration (provider: 'gemini' or 'fake')
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Topic clustering method ('llm', 'embeddings', or 'hybrid')
CLUSTERING_METHOD=llm

# Desired watch-hours per topic (used by embeddings & prompt hints)
TARGET_TOPIC_HOURS=4.0

# Difficulty effort multipliers
EFFORT_MULT_BEGINNER=1.25
EFFORT_MULT_INTERMEDIATE=1.5
EFFORT_MULT_ADVANCED=2.0

# Max playlist size to accept
MAX_PLAYLIST_VIDEOS=500

# Cache duration for fetched playlists (hours)
PLAYLIST_CACHE_HOURS=24

# Rate limit for POST /api/analyze
RATE_LIMIT_ANALYZE=10/minute

# Environment: 'development', 'production', 'test'
ENVIRONMENT=development
