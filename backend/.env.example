
# YouTube Data API v3 key
YOUTUBE_API_KEY=your_youtube_api_key_here

# MongoDB Atlas connection
# Use the Atlas host-only URI. Keep username and password separate.
MONGODB_URI=mongodb+srv://your-cluster-host.mongodb.net/
MONGODB_USERNAME=your_database_username
MONGODB_PASSWORD=your_database_password
MONGODB_DATABASE=syllabify

# Allowed frontend origins, comma-separated
CORS_ORIGINS=http://localhost:5173,https://syllabify-two.vercel.app

# LLM configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Topic clustering
CLUSTERING_METHOD=llm
TARGET_TOPIC_HOURS=4.0

# Difficulty effort multipliers
EFFORT_MULT_BEGINNER=1.25
EFFORT_MULT_INTERMEDIATE=1.5
EFFORT_MULT_ADVANCED=2.0

# Playlist configuration
MAX_PLAYLIST_VIDEOS=500
PLAYLIST_CACHE_HOURS=24

# Analyze endpoint rate limit
RATE_LIMIT_ANALYZE=10/minute

# Environment
ENVIRONMENT=development
TESTING=false
